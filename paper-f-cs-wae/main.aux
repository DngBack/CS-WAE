\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces CIFAR-10 style/semantic diagnostic. The figure probes whether varying $z_{\mathrm  {s}}$ at fixed $z_{\mathrm  {c}}$, and varying $z_{\mathrm  {c}}$ at fixed $z_{\mathrm  {s}}$, produces interpretable changes.\relax }}{11}{figure.caption.12}\protected@file@percent }
\newlabel{fig:cifar-style}{{4}{11}{CIFAR-10 style/semantic diagnostic. The figure probes whether varying $\zs $ at fixed $\zc $, and varying $\zc $ at fixed $\zs $, produces interpretable changes.\relax }{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces MNIST generation comparison. The factorized model clusters and reconstructs better, but independent sampling of $z_{\mathrm  {s}}\sim N(0,I)$ creates unrealistic or class-mismatched samples.\relax }}{12}{figure.caption.14}\protected@file@percent }
\newlabel{fig:mnist-prior-comparison}{{5}{12}{MNIST generation comparison. The factorized model clusters and reconstructs better, but independent sampling of $\zs \sim N(0,I)$ creates unrealistic or class-mismatched samples.\relax }{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces MNIST style-prior diagnostic. For each digit, three rows compare $z_{\mathrm  {s}}\sim N(0,I)$, $z_{\mathrm  {s}}=0$, and empirical posterior $z_{\mathrm  {s}}$ sampled from the same class. Empirical same-class style codes recover clean digits; independent Gaussian style codes often decode as broken or wrong-class samples.\relax }}{13}{figure.caption.15}\protected@file@percent }
\newlabel{fig:style-diagnostic}{{6}{13}{MNIST style-prior diagnostic. For each digit, three rows compare $\zs \sim N(0,I)$, $\zs =0$, and empirical posterior $\zs $ sampled from the same class. Empirical same-class style codes recover clean digits; independent Gaussian style codes often decode as broken or wrong-class samples.\relax }{figure.caption.15}{}}
