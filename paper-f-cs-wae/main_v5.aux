\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Experiment 1: Marginal Metrics Hide Leakage}{5}{}\protected@file@percent }
\newlabel{sec:cross-model}{{6.1}{5}}
\newlabel{sec:cross-model-baseline}{{6.1}{5}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces CIFAR-10 class-conditional prior samples (one row per class). FID $83$ places these in the recognizable-but-blurry regime typical of L1/LPIPS-trained decoders without an adversarial loss, well short of photorealistic (Section\nobreakspace  {}7\hbox {}).\relax }}{5}{}\protected@file@percent }
\newlabel{fig:cifar-samples}{{2}{5}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Experiment 1. Conditional style leakage across five model families on MNIST. Despite near-zero global MMD in every case, inter-class style separation $\Delta _{\mathrm  {inter}}$ is large and linear probing (LP) recovers class information well above the $10\%$ chance rate. The last row adds the remedy of Experiment 3. Self-ACC uses naive $z_{\mathrm  {s}}\sim \mathcal  {N}(0,I)$ sampling.\relax }}{6}{}\protected@file@percent }
\newlabel{tab:cross-model}{{2}{6}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Experiment 2. MNIST case study, single seed (seed 0). F-CS-WAE{} vs.\ the single-latent CS-WAE{}, which has no style latent to leak.\relax }}{6}{}\protected@file@percent }
\newlabel{tab:mnist-case}{{3}{6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Experiment 2: Leakage Breaks Class-Conditional Generation}{6}{}\protected@file@percent }
\newlabel{sec:exp2}{{6.2}{6}}
\newlabel{sec:mnist}{{6.2}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Confusion between the sampled class $y{=}k$ and the class the auxiliary classifier assigns to the generated image. Naive Gaussian sampling (left) does not fail randomly---probability mass collapses onto a handful of ``attractor'' digits (notably 8) regardless of the intended class. The class-conditional prior (right, $\tau {=}0.25$) is a clean diagonal.\relax }}{6}{}\protected@file@percent }
\newlabel{fig:confusion}{{3}{6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Direct Evidence: The Decoder Causally Uses Leaked Style}{6}{}\protected@file@percent }
\newlabel{sec:swap}{{6.3}{6}}
\@writefile{toc}{\contentsline {paragraph}{The full conditional structure, not just its mean.}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Latent swap: a causal intervention.}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Real image, posterior reconstruction, naive-prior sample, and class-conditional-prior sample, for five representative digits. Reconstructions are visually indistinguishable from the real image (SSIM $0.983$); naive-prior samples are legible digits, but frequently the \emph  {wrong} digit (e.g.\ row ``0''$\to $looks like a ``3''; row ``1''$\to $looks like a ``9''); the class-conditional prior restores the intended identity.\relax }}{7}{}\protected@file@percent }
\newlabel{fig:recon-vs-gen}{{4}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces MNIST, $\delta {=}0$: per-class $\mathrm  {MMD}^2(q(z_{\mathrm  {s}}\mid y{=}k),\mathcal  N(0,I))$ (bars) against the global MMD the marginal regularizer optimizes (dashed line). Every class sits far above the line the model was actually trained to minimize.\relax }}{7}{}\protected@file@percent }
\newlabel{fig:cmmd-bar}{{5}{7}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Experiment 3: Per-Class MMD Reduces but Does Not Eliminate Leakage}{7}{}\protected@file@percent }
\newlabel{sec:exp3}{{6.4}{7}}
\@writefile{toc}{\contentsline {paragraph}{Why does combining remedies still work at $\delta {=}1$?}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces MNIST latent-swap intervention: rows are the class donating $z_{\mathrm  {c}}$ (content), columns the class donating $z_{\mathrm  {s}}$ (style). At $\delta {=}0$ (top), off-diagonal output is almost never the content class (mean $0.1\%$) and almost always the style class (mean $99.2\%$): the decoder has learned to read identity off $z_{\mathrm  {s}}$. At $\delta {=}1$ (bottom), this flips substantially (content $60.9\%$, style $18.8\%$).\relax }}{8}{}\protected@file@percent }
\newlabel{fig:swap-heatmaps}{{6}{8}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Experiment 4: Leakage Tracks Intra-Class Diversity, Self-Accuracy Does Not}{8}{}\protected@file@percent }
\newlabel{sec:exp4}{{6.5}{8}}
\newlabel{sec:cross-dataset}{{6.5}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces MNIST latent-swap grid, $\delta {=}0$: row $=z_{\mathrm  {c}}$ donor class, column $=z_{\mathrm  {s}}$ donor class. Every row is visually identical -- identity is set entirely by the column.\relax }}{8}{}\protected@file@percent }
\newlabel{fig:swap-grid}{{7}{8}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.6}Experiment 5: Repair Does Not Transfer Uniformly Across Datasets}{8}{}\protected@file@percent }
\newlabel{sec:cifar-sampling}{{6.6}{8}}
\newlabel{sec:sampling}{{6.6}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Left: $\Delta _{\mathrm  {inter}}$ and linear-probe accuracy across datasets, ordered by increasing intra-class visual diversity---both decrease monotonically, matching the hypothesis. Right: naive-Gaussian generation self-accuracy does \emph  {not} follow the same order (CIFAR-10 is lowest, not highest); see text.\relax }}{9}{}\protected@file@percent }
\newlabel{fig:crossdataset}{{8}{9}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Experiment 5, MNIST. Generation under five $z_{\mathrm  {s}}$ sampling strategies on the $\delta {=}0$ checkpoint; $z_{\mathrm  {c}}$ always from the class prior.\relax }}{9}{}\protected@file@percent }
\newlabel{tab:sampling}{{4}{9}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.7}Experiment 6: Dataset-Dependent Clustering-Leakage Trade-off}{9}{}\protected@file@percent }
\newlabel{sec:tradeoff}{{6.7}{9}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Experiment 5, CIFAR-10. Same five sampling strategies, $\delta {=}0$ checkpoint. Unlike MNIST, the parametric class-conditional strategies plateau well below $100\%$.\relax }}{9}{}\protected@file@percent }
\newlabel{tab:cifar-sampling}{{5}{9}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Effect of per-class style MMD at six $\delta $ values, both datasets, single seed per row. $\delta {=}0$ and $\delta {=}1$ rows reproduce Tables\nobreakspace  {}2\hbox {}/3\hbox {}; the four intermediate values are new.\relax }}{9}{}\protected@file@percent }
\newlabel{tab:tradeoff}{{6}{9}}
