\@writefile{toc}{\contentsline {section}{\numberline {D}t-SNE of the Style Latent Across Model Families}{16}{}\protected@file@percent }
\newlabel{app:tsne}{{D}{16}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces CIFAR-10 naive (odd rows) vs.\ class-conditional $\tau {=}0.25$ (even rows) samples, four classes. Diversity within a row collapses under $\tau {=}0.25$, and object identity is often not clearly recognizable by eye even where the auxiliary classifier scores it correctly.\relax }}{17}{}\protected@file@percent }
\newlabel{fig:cifar-sampling-grid}{{9}{17}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Six-point $\delta $ sweep ($\delta \in \{0,0.03,0.1,0.3,1,3\}$), single seed per point, no error bars. Points are annotated with $\delta $ and connected in increasing-$\delta $ order per dataset; the connecting line is a visual aid, not a claim of a smooth underlying curve (see text). Leakage metrics (LP, $\Delta _{\mathrm  {inter}}$, $x$-axis of both panels) move smoothly with $\delta $; clustering ACC does not.\relax }}{17}{}\protected@file@percent }
\newlabel{fig:tradeoff}{{10}{17}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Experiment 7: LP($z_{\mathrm  {s}}\to y$) for the baseline and six perturbations, MNIST vs.\ CIFAR-10. Leakage survives every perturbation on both datasets (dashed line: chance), but the two capacity perturbations (balanced dims, smaller style) move CIFAR-10 far more than they move MNIST, while no-warmup and vMF-prior barely move either.\relax }}{17}{}\protected@file@percent }
\newlabel{fig:capacity-audit}{{11}{17}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces t-SNE of the style latent $z_{\mathrm  {s}}$, colored by MNIST digit class, for all six rows of Table\nobreakspace  {}2\hbox {}. Unlike a typical clustering figure, \emph  {color-separated clusters here mean worse} (class information leaking into $z_{\mathrm  {s}}$): separation is visually obvious only for WAE-MMD and F-CS-WAE{} (no per-class MMD)---the two rows with the \emph  {largest} $\Delta _{\mathrm  {inter}}$ in Table\nobreakspace  {}2\hbox {}---and visibly reduced (improved) after adding per-class style MMD. For VAE, $\beta $-TCVAE, and FactorVAE the leakage is statistically real (LP $74$--$87\%$) but not visually apparent in this 2D projection. Referenced from Experiment 1 (Section\nobreakspace  {}6.1\hbox {}).\relax }}{18}{}\protected@file@percent }
\newlabel{fig:tsne}{{12}{18}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces An alternative to the t-SNE view above, for F-CS-WAE{} at $\delta {=}0$: project $z_{\mathrm  {s}}$ onto the top principal component of the $K\times d_s$ class-mean matrix (the same signal $\Delta _{\mathrm  {inter}}$ summarizes into one scalar) and plot per-class histograms. Some classes separate cleanly along this single direction even where a 2D t-SNE embedding does not make the separation visually obvious, illustrating that a fixed low-dimensional projection can either overstate or understate leakage depending on which directions it happens to preserve -- another reason to prefer the quantitative diagnostics of Section\nobreakspace  {}3.5\hbox {} over any single plot.\relax }}{18}{}\protected@file@percent }
\newlabel{fig:cmmd-projection}{{13}{18}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Pairwise $\mathrm  {MMD}^2(q(z_{\mathrm  {s}}\mid y{=}i),q(z_{\mathrm  {s}}\mid y{=}j))$ between all class pairs, F-CS-WAE{} at $\delta {=}0$. Off-diagonal structure shows which class pairs occupy the most visibly different regions of $z_{\mathrm  {s}}$; both datasets show broad off-diagonal separation, not a few isolated confusable pairs, consistent with the per-class bar chart of Figure\nobreakspace  {}5\hbox {} showing every class contributes to the leakage rather than a small subset.\relax }}{18}{}\protected@file@percent }
\newlabel{fig:cmmd-pairwise}{{14}{18}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces CIFAR-10 counterpart to Figure\nobreakspace  {}6\hbox {}. The $\delta {=}0\to \delta {=}1$ shift is the same direction as MNIST but weaker in magnitude (content-following $4.2\%\to 20.0\%$, style-following $68.8\%\to 38.5\%$), consistent with Section\nobreakspace  {}6.3\hbox {}'s reading that CIFAR-10's decoder was never as exclusively dependent on $z_{\mathrm  {s}}$ for identity to begin with.\relax }}{18}{}\protected@file@percent }
\newlabel{fig:cifar-swap-heatmaps}{{15}{18}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces CIFAR-10 latent-swap grid, $\delta {=}0$ (cf.\ Figure\nobreakspace  {}7\hbox {} for MNIST). Rows are visually more similar to each other than in the MNIST grid but still show column-driven (style-driven) drift in object identity for several classes.\relax }}{19}{}\protected@file@percent }
\newlabel{fig:cifar-swap-grid}{{16}{19}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces MNIST sampling strategies (Table\nobreakspace  {}4\hbox {}) plotted directly: self-accuracy jumps from near-chance to $100\%$ the moment $z_{\mathrm  {s}}$ is conditioned on class in any way, while diversity (right axis) is lowest for the class-mean point estimate and highest for the empirical style bank.\relax }}{19}{}\protected@file@percent }
\newlabel{fig:mnist-sampling-bars}{{17}{19}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces MNIST generation under representation-aware style sampling. Global Gaussian produces shapeless or wrong-class images; all class-conditional strategies restore correct digit identity.\relax }}{19}{}\protected@file@percent }
\newlabel{fig:sampling-strategies}{{18}{19}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces CIFAR-10 analogue of Figure\nobreakspace  {}17\hbox {} (Table\nobreakspace  {}5\hbox {}). The class-conditional Gaussian strategies that reach $100\%$ on MNIST plateau near $70\%$ here; only resampling real encoded style codes (empirical bank) approaches MNIST-level self-accuracy.\relax }}{19}{}\protected@file@percent }
\newlabel{fig:cifar-sampling-bars}{{19}{19}}
\gdef \@abspage@last{19}
