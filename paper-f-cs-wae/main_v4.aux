\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Table\nobreakspace  {}6\hbox {} plotted directly: self-accuracy jumps from near-chance to $100\%$ the moment $z_{\mathrm  {s}}$ is conditioned on class in any way, while diversity (right axis) is lowest for the class-mean point estimate and highest for the empirical style bank---the diversity/consistency trade-off that motivates recommending $\tau {=}0.25$ over the mean as a true sampler.\relax }}{8}{}\protected@file@percent }
\newlabel{fig:mnist-sampling-bars}{{9}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces MNIST generation under representation-aware style sampling. Global Gaussian produces shapeless or wrong-class images; all class-conditional strategies restore correct digit identity.\relax }}{8}{}\protected@file@percent }
