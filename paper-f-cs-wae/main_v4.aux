\@writefile{toc}{\contentsline {paragraph}{Why CIFAR-10 is milder than MNIST, with a caveat.}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Left: $\Delta _{\mathrm  {inter}}$ and linear-probe accuracy across datasets, ordered by increasing intra-class visual diversity---both decrease monotonically, matching the hypothesis. Right: naive-Gaussian generation self-accuracy does \emph  {not} follow the same order (CIFAR-10 is lowest, not highest); we attribute this to CIFAR-10 classification being intrinsically harder for the auxiliary classifier under blurry samples, confounding self-accuracy as a leakage-severity proxy (Section\nobreakspace  {}7\hbox {}).\relax }}{8}{}\protected@file@percent }
\newlabel{fig:crossdataset}{{8}{8}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces MNIST generation under five $z_{\mathrm  {s}}$ sampling strategies on the $\delta {=}0$ checkpoint; $z_{\mathrm  {c}}$ always from the class prior.\relax }}{8}{}\protected@file@percent }
\newlabel{tab:sampling}{{6}{8}}
\@writefile{toc}{\contentsline {paragraph}{Global vs.\ conditional regularization.}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The reconstruction--generation gap.}{8}{}\protected@file@percent }
